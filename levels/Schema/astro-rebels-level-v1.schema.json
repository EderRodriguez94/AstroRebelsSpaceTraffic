{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astro-rebels-level-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "level_id", "zones"],
  "properties": {
    "schema_version": { "const": 1 },
    "level_id": { "type": "string", "minLength": 1 },
    "prequeue_capacity": { "type": "integer", "minimum": 1, "default": 16 },
    "zones": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "width", "height", "ships"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "ships": { "type": "array", "items": { "$ref": "#/$defs/ship" } }
      }
    } }
  },
  "$defs": { "ship": { "type": "object", "additionalProperties": false, "required": ["id", "color", "size", "direction"], "properties": {
    "id": { "type": "string", "minLength": 1 }, "color": { "type": "string", "minLength": 1 },
    "size": { "enum": ["Small", "Medium", "Large"] }, "direction": { "enum": ["Up", "Down", "Left", "Right"] },
    "passengers": { "type": "integer", "minimum": 0 }
  } } }
}
